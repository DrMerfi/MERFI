# Configuracion de Proveedor de LLM
# Opciones disponibles: gemini, openai, anthropic, ollama
MERFI_LLM_PROVIDER=gemini

# Claves de API (completar segun el proveedor seleccionado)
GEMINI_API_KEY=tu_clave_de_gemini_aqui
OPENAI_API_KEY=tu_clave_de_openai_aqui
ANTHROPIC_API_KEY=tu_clave_de_anthropic_aqui

# Configuracion Local para Ollama (opcional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Parametros Operativos
MERFI_TEMPERATURE=0.2
MERFI_CONFIDENCE_THRESHOLD=0.85
